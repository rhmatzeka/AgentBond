# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres for persistent reports (Neon pooled URL works on serverless).
# Leave empty to keep reports in memory; they reset when the server restarts.
DATABASE_URL=

# LLM judge for output quality. Any OpenAI-compatible endpoint works (Groq, OpenAI, OpenRouter).
# Leave the key empty to grade with the text heuristic only. AGENTBOND_LLM=off forces that.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Base Sepolia report registry
NEXT_PUBLIC_AGENTBOND_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Optional RPC for the browser wallet client (defaults to the public Base Sepolia RPC)
NEXT_PUBLIC_BASE_RPC_URL=

# Deployer wallet for `npm run deploy:base-sepolia`. Never commit a real key.
PRIVATE_KEY=
